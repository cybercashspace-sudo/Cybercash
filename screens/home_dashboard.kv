                                    MDBoxLayout:
                                        orientation: "vertical"
                                        spacing: dp(2 * root.layout_scale)
                                        adaptive_height: True

                                        MDLabel:
                                            text: "BTC / USD"
                                            theme_text_color: "Custom"
                                            text_color: TEXT_MAIN
                                            font_name: FONT_SEMI
                                            font_size: sp(12 * root.text_scale)

                                        MDLabel:
                                            text: root.market_btc_display.replace("BTC ", "")
                                            theme_text_color: "Custom"
                                            text_color: TEXT_MAIN
                                            font_name: FONT_BOLD
                                            font_size: sp(18 * root.text_scale)
                                            bold: True
                                            shorten: True
                                            shorten_from: "right"

                                        MDLabel:
                                            text: root.market_change_display
                                            theme_text_color: "Custom"
                                            text_color: [0.32, 0.86, 0.24, 1]
                                            font_name: FONT_SEMI
                                            font_size: sp(11 * root.text_scale)

                                    MDIcon:
                                        icon: "trending-up"
                                        theme_text_color: "Custom"
                                        text_color: [0.32, 0.86, 0.24, 1]
                                        font_size: sp(20 * root.icon_scale)
                                        size_hint: None, None
                                        size: dp(20 * root.layout_scale), dp(20 * root.layout_scale)
                                        pos_hint: {"center_y": 0.5}

                            MDCard:
                                radius: [dp(18 * root.layout_scale)]
                                md_bg_color: [0.09, 0.11, 0.13, 0.92]
                                line_color: [0.30, 0.48, 0.40, 0.30]
                                elevation: 0
                                padding: [dp(12 * root.layout_scale)] * 4

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    spacing: dp(10 * root.layout_scale)

                                    MDCard:
                                        size_hint: None, None
                                        size: dp(38 * root.layout_scale), dp(38 * root.layout_scale)
                                        radius: [dp(19 * root.layout_scale)]
                                        md_bg_color: [0.95, 0.74, 0.12, 0.18]
                                        elevation: 0
                                        pos_hint: {"center_y": 0.5}

                                        MDIcon:
                                            icon: "currency-usd"
                                            theme_text_color: "Custom"
                                            text_color: GOLD
                                            font_size: sp(18 * root.icon_scale)
                                            pos_hint: {"center_x": 0.5, "center_y": 0.5}

                                    MDBoxLayout:
                                        orientation: "vertical"
                                        spacing: dp(2 * root.layout_scale)
                                        adaptive_height: True

                                        MDLabel:
                                            text: "USD / GHS"
                                            theme_text_color: "Custom"
                                            text_color: TEXT_MAIN
                                            font_name: FONT_SEMI
                                            font_size: sp(12 * root.text_scale)

                                        MDLabel:
                                            text: root.market_fx_display.replace("USD/GHS ", "")
                                            theme_text_color: "Custom"
                                            text_color: TEXT_MAIN
                                            font_name: FONT_BOLD
                                            font_size: sp(18 * root.text_scale)
                                            bold: True
                                            shorten: True
                                            shorten_from: "right"

                                        MDLabel:
                                            text: "Auto-updates from the live feed."
                                            theme_text_color: "Custom"
                                            text_color: TEXT_SUB
                                            font_name: FONT_SEMI
                                            font_size: sp(11 * root.text_scale)

                                    MDIcon:
                                        icon: "trending-up"
                                        theme_text_color: "Custom"
                                        text_color: [0.32, 0.86, 0.24, 1]
                                        font_size: sp(20 * root.icon_scale)
                                        size_hint: None, None
                                        size: dp(20 * root.layout_scale), dp(20 * root.layout_scale)
                                        pos_hint: {"center_y": 0.5}

                Widget:
                    size_hint_y: None
                    height: dp(2 * root.layout_scale)

        BottomNavBar:
            nav_variant: "dashboard"
            active_target: "home"
            layout_scale: root.layout_scale
            text_scale: root.text_scale
            icon_scale: root.icon_scale
            bar_color: app.ui_surface
            active_color: app.gold
            inactive_color: app.ui_text_secondary
