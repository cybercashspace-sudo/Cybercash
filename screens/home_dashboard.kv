                            MDCard:
                                radius: [dp(18 * root.layout_scale)]
                                md_bg_color: [0.10, 0.10, 0.11, 0.92]
                                line_color: BORDER
                                elevation: 0
                                padding: [dp(8 * root.layout_scale)] * 4
