#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:set BG (0.02, 0.02, 0.02, 1)
#:set SURFACE (0.08, 0.08, 0.09, 0.94)
#:set SURFACE_SOFT (0.10, 0.10, 0.11, 0.92)
#:set BORDER (0.42, 0.42, 0.44, 0.58)
#:set GOLD (0.95, 0.74, 0.12, 1)
#:set GOLD_SOFT (0.95, 0.74, 0.12, 0.18)
#:set TEXT_MAIN (0.98, 0.98, 0.98, 1)
#:set TEXT_SUB (0.75, 0.75, 0.78, 1)
#:set FONT_REG "Roboto"
#:set FONT_SEMI "Roboto"
#:set FONT_BOLD "Roboto"

<MoreActionsContent>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(12 * root.layout_scale)
    padding: [dp(6 * root.layout_scale), dp(2 * root.layout_scale), dp(6 * root.layout_scale), dp(4 * root.layout_scale)]

    MDLabel:
        text: "Services"
        theme_text_color: "Custom"
        text_color: TEXT_MAIN
        font_name: FONT_SEMI
        font_size: sp(15 * root.text_scale)
        size_hint_y: None
        height: dp(20 * root.layout_scale)

    MDGridLayout:
        cols: 1 if root.compact_mode else 2
        adaptive_height: True
        row_default_height: dp(124 * root.layout_scale)
        row_force_default: True
        spacing: dp(10 * root.layout_scale)

        MDCard:
            radius: [dp(18 * root.layout_scale)]
            md_bg_color: [0.10, 0.10, 0.11, 0.96]
            line_color: [0.38, 0.38, 0.42, 0.45]
            elevation: 0
            padding: [dp(12 * root.layout_scale)] * 4
            on_release: root.trigger_action("airtime")

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(6 * root.layout_scale)

                MDCard:
                    size_hint: None, None
                    size: dp(44 * root.layout_scale), dp(44 * root.layout_scale)
                    radius: [dp(22 * root.layout_scale)]
                    md_bg_color: GOLD_SOFT
                    elevation: 0
                    pos_hint: {"center_x": 0.0}

                    MDIcon:
                        icon: "cellphone"
                        theme_text_color: "Custom"
                        text_color: GOLD
                        user_font_size: str(22 * root.icon_scale) + "sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                MDLabel:
                    text: "Airtime"
                    theme_text_color: "Custom"
                    text_color: TEXT_MAIN
                    font_name: FONT_SEMI
                    font_size: sp(14 * root.text_scale)

                MDLabel:
                    text: "Top up fast"
                    theme_text_color: "Custom"
                    text_color: TEXT_SUB
                    font_name: FONT_REG
                    font_size: sp(11 * root.text_scale)

        MDCard:
            radius: [dp(18 * root.layout_scale)]
            md_bg_color: [0.10, 0.10, 0.11, 0.96]
            line_color: [0.38, 0.38, 0.42, 0.45]
            elevation: 0
            padding: [dp(12 * root.layout_scale)] * 4
            on_release: root.trigger_action("data_bundle")

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(6 * root.layout_scale)

                MDCard:
                    size_hint: None, None
                    size: dp(44 * root.layout_scale), dp(44 * root.layout_scale)
                    radius: [dp(22 * root.layout_scale)]
                    md_bg_color: GOLD_SOFT
                    elevation: 0

                    MDIcon:
                        icon: "access-point-network"
                        theme_text_color: "Custom"
                        text_color: GOLD
                        user_font_size: str(22 * root.icon_scale) + "sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                MDLabel:
                    text: "Data Bundle"
                    theme_text_color: "Custom"
                    text_color: TEXT_MAIN
                    font_name: FONT_SEMI
                    font_size: sp(14 * root.text_scale)

                MDLabel:
                    text: "Fast data"
                    theme_text_color: "Custom"
                    text_color: TEXT_SUB
                    font_name: FONT_REG
                    font_size: sp(11 * root.text_scale)

        MDCard:
            radius: [dp(18 * root.layout_scale)]
            md_bg_color: [0.10, 0.10, 0.11, 0.96]
            line_color: [0.38, 0.38, 0.42, 0.45]
            elevation: 0
            padding: [dp(12 * root.layout_scale)] * 4
            on_release: root.trigger_action("p2p_transfer")

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(6 * root.layout_scale)

                MDCard:
                    size_hint: None, None
                    size: dp(44 * root.layout_scale), dp(44 * root.layout_scale)
                    radius: [dp(22 * root.layout_scale)]
                    md_bg_color: GOLD_SOFT
                    elevation: 0

                    MDIcon:
                        icon: "swap-horizontal"
                        theme_text_color: "Custom"
                        text_color: GOLD
                        user_font_size: str(22 * root.icon_scale) + "sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                MDLabel:
                    text: "Send Money"
                    theme_text_color: "Custom"
                    text_color: TEXT_MAIN
                    font_name: FONT_SEMI
                    font_size: sp(14 * root.text_scale)

                MDLabel:
                    text: "Instant transfer"
                    theme_text_color: "Custom"
                    text_color: TEXT_SUB
                    font_name: FONT_REG
                    font_size: sp(11 * root.text_scale)

        MDCard:
            radius: [dp(18 * root.layout_scale)]
            md_bg_color: [0.10, 0.10, 0.11, 0.96]
            line_color: [0.38, 0.38, 0.42, 0.45]
            elevation: 0
            padding: [dp(12 * root.layout_scale)] * 4
            on_release: root.trigger_action("airtime_2_cash")

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(6 * root.layout_scale)

                MDCard:
                    size_hint: None, None
                    size: dp(44 * root.layout_scale), dp(44 * root.layout_scale)
                    radius: [dp(22 * root.layout_scale)]
                    md_bg_color: GOLD_SOFT
                    elevation: 0

                    MDIcon:
                        icon: "swap-horizontal"
                        theme_text_color: "Custom"
                        text_color: GOLD
                        user_font_size: str(22 * root.icon_scale) + "sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                MDLabel:
                    text: "Airtime2Cash"
                    theme_text_color: "Custom"
                    text_color: TEXT_MAIN
                    font_name: FONT_SEMI
                    font_size: sp(14 * root.text_scale)

                MDLabel:
                    text: "Swap airtime"
                    theme_text_color: "Custom"
                    text_color: TEXT_SUB
                    font_name: FONT_REG
                    font_size: sp(11 * root.text_scale)

        MDCard:
            radius: [dp(18 * root.layout_scale)]
            md_bg_color: [0.10, 0.10, 0.11, 0.96]
            line_color: [0.38, 0.38, 0.42, 0.45]
            elevation: 0
            padding: [dp(12 * root.layout_scale)] * 4
            on_release: root.trigger_action("home")

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(6 * root.layout_scale)

                MDCard:
                    size_hint: None, None
                    size: dp(44 * root.layout_scale), dp(44 * root.layout_scale)
                    radius: [dp(22 * root.layout_scale)]
                    md_bg_color: GOLD_SOFT
                    elevation: 0

                    MDIcon:
                        icon: "close"
                        theme_text_color: "Custom"
                        text_color: GOLD
                        user_font_size: str(22 * root.icon_scale) + "sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                MDLabel:
                    text: "Close"
                    theme_text_color: "Custom"
                    text_color: TEXT_MAIN
                    font_name: FONT_SEMI
                    font_size: sp(14 * root.text_scale)

                MDLabel:
                    text: "Dismiss panel"
                    theme_text_color: "Custom"
                    text_color: TEXT_SUB
                    font_name: FONT_REG
                    font_size: sp(11 * root.text_scale)

        MDCard:
            radius: [dp(18 * root.layout_scale)]
            md_bg_color: [0.14, 0.09, 0.09, 0.96]
            line_color: [0.64, 0.32, 0.32, 0.38]
            elevation: 0
            padding: [dp(12 * root.layout_scale)] * 4
            opacity: 1 if app.is_admin else 0.0
            disabled: not app.is_admin
            on_release: root.trigger_action("admin_dashboard")

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(6 * root.layout_scale)

                MDCard:
                    size_hint: None, None
                    size: dp(44 * root.layout_scale), dp(44 * root.layout_scale)
                    radius: [dp(22 * root.layout_scale)]
                    md_bg_color: [0.25, 0.12, 0.12, 0.96]
                    elevation: 0

                    MDIcon:
                        icon: "shield-account"
                        theme_text_color: "Custom"
                        text_color: [1, 0.65, 0.65, 1]
                        user_font_size: str(22 * root.icon_scale) + "sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                MDLabel:
                    text: "Admin Tools"
                    theme_text_color: "Custom"
                    text_color: TEXT_MAIN
                    font_name: FONT_SEMI
                    font_size: sp(14 * root.text_scale)

                MDLabel:
                    text: "Management"
                    theme_text_color: "Custom"
                    text_color: TEXT_SUB
                    font_name: FONT_REG
                    font_size: sp(11 * root.text_scale)

<HomeScreen>:
    MDBoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: BG
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: (0.20, 0.12, 0.00, 0.20)
            Ellipse:
                pos: self.x - self.width * 0.16, self.top - self.width * 0.42
                size: self.width * 0.82, self.width * 0.82
            Color:
                rgba: (0.55, 0.35, 0.00, 0.10)
            Ellipse:
                pos: self.x + self.width * 0.28, self.y - self.width * 0.26
                size: self.width * 0.86, self.width * 0.86

        MDScrollViewRefreshLayout:
            id: refresh_layout
            root_layout: app.root
            refresh_callback: root.refresh_dashboard
            spinner_color: app.gold
            circle_color: app.ui_background
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                size_hint_x: None
                width: min((self.parent.width if self.parent else root.width), dp(760))
                pos_hint: {"center_x": 0.5}
                padding: [dp(16 * root.layout_scale), dp(14 * root.layout_scale), dp(16 * root.layout_scale), dp(18 * root.layout_scale)]
                spacing: dp(12 * root.layout_scale)

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(58 * root.layout_scale)
                    spacing: dp(10 * root.layout_scale)

                    MDIconButton:
                        icon: "menu"
                        user_font_size: str(30 * root.icon_scale) + "sp"
                        theme_text_color: "Custom"
                        text_color: TEXT_MAIN
                        size_hint: None, None
                        size: dp(46 * root.layout_scale), dp(46 * root.layout_scale)
                        on_release: root.open_more_actions()

                    FitImage:
                        source: root.brand_logo_source
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(46 * root.layout_scale)
                        pos_hint: {"center_y": 0.5}

                    FloatLayout:
                        size_hint: None, None
                        size: dp(138 * root.layout_scale), dp(54 * root.layout_scale)

                        MDCard:
                            size_hint: None, None
                            size: dp(50 * root.layout_scale), dp(50 * root.layout_scale)
                            radius: [dp(16 * root.layout_scale)]
                            md_bg_color: [0.08, 0.08, 0.09, 0.92]
                            line_color: [0.46, 0.37, 0.15, 0.24]
                            elevation: 0
                            padding: 0
                            pos_hint: {"center_x": 0.22, "center_y": 0.5}
                            on_release: root.go_to("transactions")

                            MDIcon:
                                icon: "bell-outline"
                                theme_text_color: "Custom"
                                text_color: TEXT_MAIN
                                user_font_size: str(24 * root.icon_scale) + "sp"
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                        MDCard:
                            size_hint: None, None
                            size: dp(22 * root.layout_scale), dp(22 * root.layout_scale)
                            radius: [dp(11 * root.layout_scale)]
                            md_bg_color: [0.95, 0.74, 0.12, 1]
                            elevation: 0
                            pos_hint: {"center_x": 0.49, "center_y": 0.80}
                            opacity: 1 if root.notification_badge_visible else 0

                            MDLabel:
                                text: root.notification_count_text
                                halign: "center"
                                valign: "center"
                                theme_text_color: "Custom"
                                text_color: [0.08, 0.08, 0.08, 1]
                                font_name: FONT_BOLD
                                font_size: sp(10 * root.text_scale)
                                bold: True

                        MDCard:
                            size_hint: None, None
                            size: dp(50 * root.layout_scale), dp(50 * root.layout_scale)
                            radius: [dp(25 * root.layout_scale)]
                            md_bg_color: [0.08, 0.08, 0.09, 0.92]
                            line_color: [0.95, 0.74, 0.12, 0.95]
                            elevation: 0
                            padding: 0
                            pos_hint: {"center_x": 0.82, "center_y": 0.5}
                            on_release: root.go_to("settings")

                            FitImage:
                                source: root.avatar_source
                                size_hint: None, None
                                size: dp(42 * root.layout_scale), dp(42 * root.layout_scale)
                                radius: [dp(21 * root.layout_scale)]
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                opacity: 1 if root.avatar_source else 0

                            MDIcon:
                                icon: "account"
                                theme_text_color: "Custom"
                                text_color: app.gold
                                user_font_size: str(28 * root.icon_scale) + "sp"
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                opacity: 0 if root.avatar_source else 1

                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(54 * root.layout_scale)
                    spacing: dp(2 * root.layout_scale)

                    MDLabel:
                        text: root.time_of_day_text.title() + " ☀"
                        theme_text_color: "Custom"
                        text_color: app.gold
                        font_name: FONT_SEMI
                        font_size: sp(15 * root.text_scale)
                        size_hint_y: None
                        height: dp(18 * root.layout_scale)
                        shorten: True
                        shorten_from: "right"

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(32 * root.layout_scale)
                        spacing: dp(8 * root.layout_scale)

                        MDLabel:
                            text: app.user_name if app.user_name else "Cyber Cash User"
                            theme_text_color: "Custom"
                            text_color: TEXT_MAIN
                            font_name: FONT_BOLD
                            font_size: sp(22 * root.text_scale)
                            bold: True
                            shorten: True
                            shorten_from: "right"

                        MDCard:
                            size_hint: None, None
                            size: dp(128 * root.layout_scale), dp(28 * root.layout_scale)
                            radius: [dp(14 * root.layout_scale)]
                            md_bg_color: [0.21, 0.16, 0.05, 0.96]
                            line_color: [0.95, 0.74, 0.12, 0.30]
                            elevation: 0
                            padding: [dp(8 * root.layout_scale), 0, dp(8 * root.layout_scale), 0]

                            MDBoxLayout:
                                spacing: dp(6 * root.layout_scale)
                                adaptive_height: True
                                pos_hint: {"center_y": 0.5}

                                MDIcon:
                                    icon: "check-decagram"
                                    theme_text_color: "Custom"
                                    text_color: app.gold
                                    font_size: sp(14 * root.icon_scale)
                                    size_hint: None, None
                                    size: dp(14 * root.layout_scale), dp(14 * root.layout_scale)
                                    pos_hint: {"center_y": 0.5}

                                MDLabel:
                                    text: "Verified User"
                                    theme_text_color: "Custom"
                                    text_color: app.gold
                                    font_name: FONT_SEMI
                                    font_size: sp(11 * root.text_scale)
                                    bold: True
                                    valign: "middle"
                                    shorten: True
                                    shorten_from: "right"

                GradientMDCard:
                    id: hero_card
                    size_hint_y: None
                    height: dp(338 * root.layout_scale) if not root.compact_mode else dp(304 * root.layout_scale)
                    radius: [dp(28 * root.layout_scale)]
                    gradient_start: [0.05, 0.05, 0.06, 1]
                    gradient_end: [0.02, 0.02, 0.03, 1]
                    border_color: [0.97, 0.78, 0.15, 0.96]
                    border_width: dp(1.2)
                    padding: [dp(18 * root.layout_scale), dp(18 * root.layout_scale), dp(18 * root.layout_scale), dp(16 * root.layout_scale)]

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(6 * root.layout_scale) if root.compact_mode else dp(12 * root.layout_scale)

                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint_x: 1 if root.compact_mode else 0.56
                            spacing: dp(8 * root.layout_scale) if root.compact_mode else dp(10 * root.layout_scale)

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(54 * root.layout_scale)
                                spacing: dp(10 * root.layout_scale)

                                MDCard:
                                    size_hint: None, None
                                    size: dp(54 * root.layout_scale), dp(54 * root.layout_scale)
                                    radius: [dp(27 * root.layout_scale)]
                                    md_bg_color: [0.07, 0.07, 0.08, 0.98]
                                    line_color: [0.95, 0.74, 0.12, 0.70]
                                    elevation: 0
                                    padding: 0
                                    pos_hint: {"center_y": 0.5}

                                    MDBoxLayout:
                                        orientation: "vertical"
                                        padding: dp(2 * root.layout_scale)
                                        spacing: 0

                                        Widget:
                                            size_hint_y: 0.34
                                            canvas.before:
                                                Color:
                                                    rgba: 0.84, 0.13, 0.14, 1
                                                Rectangle:
                                                    pos: self.pos
                                                    size: self.size

                                        AnchorLayout:
                                            size_hint_y: 0.32
                                            anchor_x: "center"
                                            anchor_y: "center"
                                            canvas.before:
                                                Color:
                                                    rgba: 0.95, 0.74, 0.12, 1
                                                Rectangle:
                                                    pos: self.pos
                                                    size: self.size

                                            MDIcon:
                                                icon: "star"
                                                theme_text_color: "Custom"
                                                text_color: [0.05, 0.05, 0.05, 1]
                                                user_font_size: str(13 * root.icon_scale) + "sp"

                                        Widget:
                                            size_hint_y: 0.34
                                            canvas.before:
                                                Color:
                                                    rgba: 0.12, 0.52, 0.22, 1
                                                Rectangle:
                                                    pos: self.pos
                                                    size: self.size

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    spacing: dp(8 * root.layout_scale)
                                    adaptive_height: True
                                    pos_hint: {"center_y": 0.5}

                                    MDLabel:
                                        text: "WALLET BALANCE"
                                        theme_text_color: "Custom"
                                        text_color: TEXT_MAIN
                                        font_name: FONT_SEMI
                                        font_size: sp(18 * root.text_scale)
                                        adaptive_height: True

                            MDLabel:
                                id: hero_balance_label
                                text: root.balance_display
                                theme_text_color: "Custom"
                                text_color: TEXT_MAIN
                                font_name: FONT_BOLD
                                font_style: "H2"
                                font_size: sp(34 * root.text_scale)
                                bold: True
                                shorten: True
                                shorten_from: "right"
                                size_hint_y: None
                                height: dp(60 * root.layout_scale)

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(58 * root.layout_scale)
                                spacing: dp(12 * root.layout_scale)

                                MDBoxLayout:
                                    orientation: "vertical"
                                    spacing: dp(4 * root.layout_scale)
                                    size_hint_x: 0.5

                                    MDLabel:
                                        text: "Available Balance"
                                        theme_text_color: "Custom"
                                        text_color: GOLD
                                        font_name: FONT_SEMI
                                        font_size: sp(15 * root.text_scale)
                                        size_hint_y: None
                                        height: dp(20 * root.layout_scale)

                                    MDLabel:
                                        text: root.available_balance_display
                                        theme_text_color: "Custom"
                                        text_color: TEXT_MAIN
                                        font_name: FONT_SEMI
                                        font_size: sp(16 * root.text_scale)
                                        size_hint_y: None
                                        height: dp(22 * root.layout_scale)
                                        shorten: True
                                        shorten_from: "right"

                                Widget:
                                    size_hint_x: None
                                    width: dp(1 * root.layout_scale)
                                    canvas.before:
                                        Color:
                                            rgba: 0.95, 0.74, 0.12, 0.34
                                        Rectangle:
                                            pos: self.pos
                                            size: self.size

                                MDBoxLayout:
                                    orientation: "vertical"
                                    spacing: dp(4 * root.layout_scale)
                                    size_hint_x: 0.5

                                    MDLabel:
                                        text: "Bonus"
                                        theme_text_color: "Custom"
                                        text_color: GOLD
                                        font_name: FONT_SEMI
                                        font_size: sp(15 * root.text_scale)
                                        size_hint_y: None
                                        height: dp(20 * root.layout_scale)

                                    MDLabel:
                                        text: root.bonus_balance_display
                                        theme_text_color: "Custom"
                                        text_color: TEXT_MAIN
                                        font_name: FONT_SEMI
                                        font_size: sp(16 * root.text_scale)
                                        size_hint_y: None
                                        height: dp(22 * root.layout_scale)
                                        shorten: True
                                        shorten_from: "right"

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(56 * root.layout_scale)
                                spacing: dp(10 * root.layout_scale)

                                MDCard:
                                    size_hint_x: 0.52
                                    radius: [dp(18 * root.layout_scale)]
                                    md_bg_color: [0.95, 0.74, 0.12, 1]
                                    line_color: [0.98, 0.86, 0.36, 0.56]
                                    elevation: 0
                                    padding: [dp(12 * root.layout_scale), dp(8 * root.layout_scale), dp(12 * root.layout_scale), dp(8 * root.layout_scale)]
                                    on_release: root.go_to("deposit")

                                    MDBoxLayout:
                                        spacing: dp(10 * root.layout_scale)
                                        adaptive_height: True
                                        pos_hint: {"center_y": 0.5}

                                        MDCard:
                                            size_hint: None, None
                                            size: dp(34 * root.layout_scale), dp(34 * root.layout_scale)
                                            radius: [dp(17 * root.layout_scale)]
                                            md_bg_color: [0.08, 0.08, 0.08, 0.90]
                                            elevation: 0

                                            MDIcon:
                                                icon: "plus"
                                                theme_text_color: "Custom"
                                                text_color: [0.05, 0.05, 0.05, 1]
                                                font_size: sp(20 * root.icon_scale)
                                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                                        MDLabel:
                                            text: "Add Money"
                                            theme_text_color: "Custom"
                                            text_color: [0.05, 0.05, 0.05, 1]
                                            font_name: FONT_BOLD
                                            font_size: sp(16 * root.text_scale)
                                            bold: True
                                            valign: "middle"
                                            shorten: True
                                            shorten_from: "right"

                                MDCard:
                                    size_hint_x: 0.48
                                    radius: [dp(18 * root.layout_scale)]
                                    md_bg_color: [0.10, 0.10, 0.11, 0.95]
                                    line_color: [0.42, 0.42, 0.44, 0.55]
                                    elevation: 0
