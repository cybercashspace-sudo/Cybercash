#:import auth_asset_path core.auth_assets.auth_asset_path
#:import dp kivy.metrics.dp

<LoginScreen>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Rectangle:
            source: auth_asset_path("00_full_reference.png")
            pos: self.pos
            size: self.size

    FloatLayout:
        TextInput:
            id: username
            multiline: False
            background_normal: ""
            background_active: ""
            background_color: 0, 0, 0, 0
            foreground_color: 0.91, 0.91, 0.91, 1
            cursor_color: 0.96, 0.77, 0.11, 1
            selection_color: 0.42, 0.34, 0.06, 1
            font_size: dp(19)
            padding: [dp(0), dp(0), dp(0), dp(0)]
            size_hint: 0.80, None
            height: dp(66)
            pos_hint: {"x": 0.145, "y": 0.513}
            on_text_validate: root.login()

        TextInput:
            id: password
            multiline: False
            password: True
            background_normal: ""
            background_active: ""
            background_color: 0, 0, 0, 0
            foreground_color: 0.91, 0.91, 0.91, 1
            cursor_color: 0.96, 0.77, 0.11, 1
            selection_color: 0.42, 0.34, 0.06, 1
            font_size: dp(19)
            padding: [dp(0), dp(0), dp(0), dp(0)]
            size_hint: 0.80, None
            height: dp(66)
            pos_hint: {"x": 0.145, "y": 0.390}
            on_text_validate: root.login()

        Button:
            id: remember_toggle
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: None, None
            size: dp(32), dp(32)
            pos_hint: {"x": 0.078, "y": 0.413}
            on_release: root.toggle_remember(not root.remember_me)

        Button:
            id: password_toggle
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: None, None
            size: dp(58), dp(58)
            pos_hint: {"x": 0.845, "y": 0.394}
            on_release: root.toggle_password()

        Button:
            id: login_tab
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: None, None
            size: dp(145), dp(65)
            pos_hint: {"x": 0.075, "y": 0.590}
            on_release: root.username.focus = True

        Button:
            id: signup_tab
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: None, None
            size: dp(150), dp(65)
            pos_hint: {"x": 0.285, "y": 0.590}
            on_release: root.signup()

        Button:
            id: forgot_password_button
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: None, None
            size: dp(190), dp(48)
            pos_hint: {"x": 0.68, "y": 0.408}
            on_release: root.forgot_password()

        Button:
            id: login_button
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: 0.80, None
            height: dp(82)
            pos_hint: {"x": 0.10, "y": 0.315}
            on_release: root.login()

        Button:
            id: google_login
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: 0.185, None
            height: dp(135)
            pos_hint: {"x": 0.080, "y": 0.181}
            on_release: root.google_login()

        Button:
            id: facebook_login
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: 0.185, None
            height: dp(135)
            pos_hint: {"x": 0.294, "y": 0.181}
            on_release: root.facebook_login()

        Button:
            id: apple_login
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: 0.185, None
            height: dp(135)
            pos_hint: {"x": 0.510, "y": 0.181}
            on_release: root.apple_login()

        Button:
            id: phone_login
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: 0.185, None
            height: dp(135)
            pos_hint: {"x": 0.724, "y": 0.181}
            on_release: root.phone_login()

        Button:
            id: bottom_signup
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            border: 0, 0, 0, 0
            color: 0, 0, 0, 0
            size_hint: None, None
            size: dp(300), dp(65)
            pos_hint: {"x": 0.43, "y": 0.055}
            on_release: root.signup()
