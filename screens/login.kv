#:import auth_asset_path core.auth_assets.auth_asset_path
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<LoginScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 0.02, 0.02, 0.03, 1
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: 0.24, 0.17, 0.03, 0.18
            Ellipse:
                pos: self.width - dp(330), self.height - dp(280)
                size: dp(430), dp(430)
            Color:
                rgba: 0.95, 0.79, 0.27, 0.08
            Ellipse:
                pos: -dp(130), self.height - dp(180)
                size: dp(280), dp(280)

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(16), dp(16), dp(16), dp(22)]
                spacing: dp(12)

                Widget:
                    size_hint_y: None
                    height: dp(4)

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(6)

                    Image:
                        source: auth_asset_path("01_cyber_cash_shield_logo.png")
                        size_hint: 1, None
                        height: dp(150)
                        allow_stretch: True
                        keep_ratio: True

                    Image:
                        source: auth_asset_path("21_cyber_cash_wordmark.png")
                        size_hint: 1, None
                        height: dp(54)
                        allow_stretch: True
                        keep_ratio: True

                    Image:
                        source: auth_asset_path("22_tagline.png")
                        size_hint: 1, None
                        height: dp(28)
                        allow_stretch: True
                        keep_ratio: True

                MDCard:
                    radius: [dp(28)]
                    padding: [dp(18)] * 4
                    size_hint_y: None
                    height: self.minimum_height
                    md_bg_color: 0.04, 0.04, 0.05, 1
                    line_color: [0.92, 0.73, 0.22, 0.58]
                    elevation: 0

                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(12)

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: dp(160)
                            spacing: dp(12)

                            MDBoxLayout:
                                orientation: "vertical"
                                spacing: dp(8)
                                size_hint_x: 0.58
                                size_hint_y: 1

                                MDLabel:
                                    text: "Welcome Back!"
                                    theme_text_color: "Custom"
                                    text_color: 0.96, 0.96, 0.97, 1
                                    bold: True
                                    font_size: sp(25)
                                    text_size: self.width, None
                                    halign: "left"
                                    size_hint_y: None
                                    height: self.texture_size[1] if self.text else 0

                                MDLabel:
                                    text: "Login to continue to your account"
                                    theme_text_color: "Custom"
                                    text_color: 0.74, 0.76, 0.80, 1
                                    font_size: sp(13.5)
                                    text_size: self.width, None
                                    halign: "left"
                                    size_hint_y: None
                                    height: self.texture_size[1] if self.text else 0

                                MDBoxLayout:
                                    size_hint_y: None
                                    height: dp(34)
                                    spacing: dp(18)

                                MDBoxLayout:
                                    orientation: "vertical"
                                    size_hint_x: None
                                    width: self.minimum_width
                                    spacing: dp(4)

                                    MDTextButton:
                                        id: login_tab
                                        text: "Login"
                                        theme_text_color: "Custom"
                                        text_color: 0.95, 0.79, 0.27, 1
                                        font_size: sp(15)
                                        on_release: root.ids.username.focus = True

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: dp(2)
                                        canvas.before:
                                            Color:
                                                rgba: 0.95, 0.79, 0.27, 1
                                            Rectangle:
                                                pos: self.pos
                                                size: self.size

                                    MDTextButton:
                                        id: signup_tab
                                        text: "Sign Up"
                                        theme_text_color: "Custom"
                                        text_color: 0.74, 0.76, 0.80, 1
                                        font_size: sp(15)
                                        on_release: root.signup()

                            Image:
                                source: auth_asset_path("03_phone_card_lock_cluster.png")
                                size_hint_x: 0.42
                                size_hint_y: 1
                                allow_stretch: True
                                keep_ratio: True

                        MDBoxLayout:
                            size_hint_y: None
                            height: dp(1)
                            canvas.before:
                                Color:
                                    rgba: 0.90, 0.72, 0.18, 0.34
                                Rectangle:
                                    pos: self.pos
                                    size: self.size

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            spacing: dp(10)

                            MDBoxLayout:
                                orientation: "horizontal"
                                adaptive_height: True
                                spacing: dp(10)

                                MDIconButton:
                                    icon: "account-outline"
                                    theme_text_color: "Custom"
                                    text_color: 0.95, 0.79, 0.27, 1
                                    user_font_size: "22sp"
                                    size_hint: None, None
                                    size: dp(36), dp(36)
                                    disabled: True

                                MDTextField:
                                    id: username
                                    hint_text: "MoMo number"
                                    helper_text: "Enter your mobile money number."
                                    helper_text_mode: "on_focus"
                                    mode: "fill"
                                    theme_bg_color: "Custom"
                                    fill_color_normal: 0.11, 0.12, 0.14, 1
                                    fill_color_focus: 0.14, 0.15, 0.18, 1
                                    theme_line_color: "Custom"
                                    line_color_normal: 0.28, 0.22, 0.08, 0.76
                                    line_color_focus: 0.95, 0.79, 0.27, 1
                                    text_color_normal: 0.95, 0.95, 0.96, 1
                                    text_color_focus: 0.95, 0.95, 0.96, 1
                                    font_size: sp(13.5)
                                    multiline: False
                                    input_filter: "int"
                                    on_text_validate: password.focus = True

                            MDBoxLayout:
                                orientation: "horizontal"
                                adaptive_height: True
                                spacing: dp(10)

                                MDIconButton:
                                    icon: "lock-outline"
                                    theme_text_color: "Custom"
                                    text_color: 0.95, 0.79, 0.27, 1
                                    user_font_size: "22sp"
                                    size_hint: None, None
                                    size: dp(36), dp(36)
                                    disabled: True

                                MDTextField:
                                    id: password
                                    hint_text: "PIN"
                                    helper_text: "Enter your 4-digit PIN."
                                    helper_text_mode: "on_focus"
                                    mode: "fill"
                                    theme_bg_color: "Custom"
                                    fill_color_normal: 0.11, 0.12, 0.14, 1
                                    fill_color_focus: 0.14, 0.15, 0.18, 1
                                    theme_line_color: "Custom"
                                    line_color_normal: 0.28, 0.22, 0.08, 0.76
                                    line_color_focus: 0.95, 0.79, 0.27, 1
                                    text_color_normal: 0.95, 0.95, 0.96, 1
                                    text_color_focus: 0.95, 0.95, 0.96, 1
                                    font_size: sp(13.5)
                                    password: True
                                    multiline: False
                                    input_filter: "int"
                                    on_text_validate: root.login()

                                MDIconButton:
                                    id: password_toggle
                                    icon: "eye-off"
                                    theme_text_color: "Custom"
                                    text_color: 0.95, 0.79, 0.27, 1
                                    user_font_size: "22sp"
                                    size_hint: None, None
                                    size: dp(36), dp(36)
                                    on_release: root.toggle_password()

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(34)
                                spacing: dp(8)

                                MDCheckbox:
                                    id: remember_toggle
                                    active: True
                                    on_active: root.toggle_remember(*args)

                                MDLabel:
                                    text: "Remember Me"
                                    valign: "middle"
                                    theme_text_color: "Custom"
                                    text_color: 0.95, 0.95, 0.96, 1
                                    font_size: sp(12.5)
                                    size_hint_y: None
                                    height: self.texture_size[1] if self.text else 0

                                Widget:

                                MDTextButton:
                                    id: forgot_password_button
                                    text: "Forgot Password?"
                                    theme_text_color: "Custom"
                                    text_color: 0.95, 0.79, 0.27, 1
                                    font_size: sp(12.5)
                                    on_release: root.forgot_password()

                            MDFillRoundFlatIconButton:
                                id: login_button
                                text: "Login"
                                icon: "arrow-right-circle"
                                md_bg_color: 0.98, 0.80, 0.22, 1
                                text_color: 0.02, 0.02, 0.03, 1
                                size_hint_y: None
                                height: dp(58)
                                on_release: root.login()

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(24)
                                spacing: dp(12)

                                MDSeparator:
                                    size_hint_y: None
                                    height: dp(1)
                                MDLabel:
                                    text: "OR"
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.80, 0.82, 1
                                    bold: True
                                    font_size: sp(12)
                                    size_hint_x: None
                                    width: self.texture_size[0]
                                    halign: "center"
                                MDSeparator:
                                    size_hint_y: None
                                    height: dp(1)

                            MDGridLayout:
                                cols: 2
                                adaptive_height: True
                                spacing: dp(12)

                                MDFillRoundFlatIconButton:
                                    text: "Google"
                                    icon: "google"
                                    md_bg_color: 0.12, 0.12, 0.13, 1
                                    text_color: 0.95, 0.95, 0.96, 1
                                    size_hint_y: None
                                    height: dp(54)
                                    on_release: root.google_login()

                                MDFillRoundFlatIconButton:
                                    text: "Facebook"
                                    icon: "facebook"
                                    md_bg_color: 0.12, 0.12, 0.13, 1
                                    text_color: 0.95, 0.95, 0.96, 1
                                    size_hint_y: None
                                    height: dp(54)
                                    on_release: root.facebook_login()

                                MDFillRoundFlatIconButton:
                                    text: "Apple"
                                    icon: "apple"
                                    md_bg_color: 0.12, 0.12, 0.13, 1
                                    text_color: 0.95, 0.95, 0.96, 1
                                    size_hint_y: None
                                    height: dp(54)
                                    on_release: root.apple_login()

                                MDFillRoundFlatIconButton:
                                    text: "Phone"
                                    icon: "phone"
                                    md_bg_color: 0.12, 0.12, 0.13, 1
                                    text_color: 0.95, 0.95, 0.96, 1
                                    size_hint_y: None
                                    height: dp(54)
                                    on_release: root.phone_login()

                            Image:
                                source: auth_asset_path("25_security_feature_bar.png")
                                size_hint_y: None
                                height: dp(92)
                                allow_stretch: True
                                keep_ratio: True

                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(34)
                                spacing: dp(8)
                                pos_hint: {"center_x": 0.5}

                                MDLabel:
                                    text: "Don't have an account?"
                                    halign: "right"
                                    theme_text_color: "Custom"
                                    text_color: 0.95, 0.95, 0.96, 1
                                    font_size: sp(12.5)
                                    size_hint_x: None
                                    width: self.texture_size[0]

                                MDTextButton:
                                    text: "Sign Up"
                                    theme_text_color: "Custom"
                                    text_color: 0.95, 0.79, 0.27, 1
                                    font_size: sp(12.5)
                                    on_release: root.signup()

                                Image:
                                    source: auth_asset_path("20_bottom_signup_arrow.png")
                                    size_hint: None, None
                                    size: dp(18), dp(18)
                                    allow_stretch: True
                                    keep_ratio: True
