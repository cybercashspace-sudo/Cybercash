#:import dp kivy.metrics.dp
#:import theme theme
#:import GlassCard widgets.GlassCard
#:import AuthButton features.auth.widgets.auth_button.AuthButton

<AirtimeScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.03, 0.03, 0.03, 1

        MDBoxLayout:
            size_hint_y: None
            height: "72dp"
            padding: "18dp", "12dp"

            MDLabel:
                text: "Buy Airtime"
                bold: True
                font_size: "22sp"
                theme_text_color: "Custom"
                text_color: 1, 0.76, 0.12, 1

            Widget:

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: "16dp"
                padding: "16dp"

                GlassCard:
                    size_hint_y: None
                    height: "110dp"
                    padding: "16dp"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "6dp"

                        MDLabel:
                            text: "Wallet Balance"
                            theme_text_color: "Secondary"
                            font_size: "13sp"

                        MDLabel:
                            id: balance_label
                            text: "GHS 0.00"
                            font_size: "30sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 0.76, 0.12, 1

                GlassCard:
                    size_hint_y: None
                    height: "320dp"
                    padding: "16dp"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "12dp"

                        MDTextField:
                            id: phone
                            hint_text: "Phone Number"
                            text: ""
                            on_text: root.on_phone_text(self.text)

                        MDTextField:
                            id: network
                            hint_text: "Detected Network"
                            text: "Unknown"
                            readonly: True

                        MDTextField:
                            id: amount
                            hint_text: "Amount (GHS)"
                            input_filter: "float"

                        Widget:

                        AuthButton:
                            id: purchase_button
                            text: "BUY NOW"
                            busy_text: "PROCESSING..."
                            on_release: root.submit_purchase()
