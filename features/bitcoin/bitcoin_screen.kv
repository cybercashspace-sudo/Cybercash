#:import GlassCard widgets.GlassCard
#:import AppButton components.app_button.AppButton
#:import TransactionCard components.transaction_card.TransactionCard

<BitcoinScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.03, 0.03, 0.03, 1

        MDBoxLayout:
            size_hint_y: None
            height: "72dp"
            padding: "18dp", "12dp"
            spacing: "12dp"

            MDLabel:
                text: "Bitcoin Wallet"
                bold: True
                font_size: "22sp"
                theme_text_color: "Custom"
                text_color: 1, 0.76, 0.12, 1

            Widget:

            MDIconButton:
                icon: "refresh"
                theme_icon_color: "Custom"
                icon_color: 1, 0.76, 0.12, 1
                on_release: root.load_dashboard()

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: "16dp"
                padding: "16dp"

                GlassCard:
                    size_hint_y: None
                    height: "180dp"
                    padding: "18dp"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "6dp"

                        MDLabel:
                            text: "Bitcoin Balance"
                            theme_text_color: "Secondary"
                            font_size: "13sp"

                        MDLabel:
                            id: wallet_balance
                            text: "₿ 0.000000"
                            font_size: "34sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 0.76, 0.12, 1

                        MDLabel:
                            id: wallet_usd
                            text: "≈ GH₵ 0.00"
                            theme_text_color: "Secondary"
                            font_size: "14sp"

                        Widget:

                        MDLabel:
                            id: wallet_status
                            text: "Active"
                            theme_text_color: "Secondary"
                            font_size: "12sp"

                        MDLabel:
                            id: wallet_address
                            text: "Not available"
                            theme_text_color: "Hint"
                            font_size: "11sp"
                            shorten: True
                            shorten_from: "right"

                GlassCard:
                    size_hint_y: None
                    height: "120dp"
                    padding: "18dp"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "8dp"

                        MDLabel:
                            text: "Current BTC Price"
                            theme_text_color: "Secondary"
                            font_size: "13sp"

                        MDLabel:
                            id: btc_price
                            text: "$0.00"
                            font_size: "26sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 0.76, 0.12, 1

                        MDLabel:
                            text: "Live market refresh is enabled"
                            theme_text_color: "Hint"
                            font_size: "12sp"

                MDGridLayout:
                    cols: 2
                    adaptive_height: True
                    spacing: "12dp"

                    AppButton:
                        text: "Buy BTC"
                        variant: "primary"
                        on_release: root.buy_btc()

                    AppButton:
                        text: "Sell BTC"
                        variant: "secondary"
                        on_release: root.sell_btc()

                    AppButton:
                        text: "Deposit"
                        variant: "secondary"
                        on_release: root.deposit_btc()

                    AppButton:
                        text: "Withdraw"
                        variant: "secondary"
                        on_release: root.withdraw_btc()

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: "10dp"

                    MDLabel:
                        text: "Recent BTC Transactions"
                        bold: True
                        font_size: "18sp"

                    RecycleView:
                        id: transaction_list
                        viewclass: "TransactionCard"
                        size_hint_y: None
                        height: "320dp"

                        RecycleBoxLayout:
                            default_size: None, "88dp"
                            default_size_hint: 1, None
                            size_hint_y: None
                            height: self.minimum_height
                            orientation: "vertical"
