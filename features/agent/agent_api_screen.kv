#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import BottomNavBar core.bottom_nav.BottomNavBar

<AgentApiScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.03, 0.03, 0.03, 1

        MDBoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(12), dp(6)
            spacing: dp(8)

            MDTextButton:
                text: "Back"
                theme_text_color: "Custom"
                text_color: 1, 0.76, 0.12, 1
                on_release: root.go_back()

            MDLabel:
                text: "API Access"
                bold: True
                font_size: sp(21)
                theme_text_color: "Custom"
                text_color: 1, 0.76, 0.12, 1

            MDIconButton:
                icon: "refresh"
                theme_text_color: "Custom"
                text_color: 1, 0.76, 0.12, 1
                on_release: root.load_api_keys()

        PullRefreshScrollView:
            root_layout: root
            refresh_callback: root.pull_to_refresh
            spinner_color: app.gold
            circle_color: app.ui_background
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: dp(16), dp(14), dp(16), dp(20)

                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(150)
                    radius: [dp(20)]
                    elevation: 0
                    md_bg_color: 0.09, 0.10, 0.12, 1
                    padding: dp(16)
                    spacing: dp(6)

                    MDLabel:
                        text: "Receive customer payments"
                        bold: True
                        font_size: sp(17)
                        theme_text_color: "Custom"
                        text_color: 0.94, 0.79, 0.46, 1
                        adaptive_height: True

                    MDLabel:
                        text: "Create test keys for safe integration checks, or live keys for real Paystack checkouts. Confirmed live payments reach your CyberCash wallet. Keep secret keys on your server."
                        theme_text_color: "Secondary"
                        font_size: sp(13)
                        adaptive_height: True

                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(390)
                    radius: [dp(20)]
                    elevation: 0
                    md_bg_color: 0.09, 0.10, 0.12, 1
                    padding: dp(16)
                    spacing: dp(8)

                    MDLabel:
                        text: "Create API key"
                        bold: True
                        font_size: sp(16)
                        adaptive_height: True

                    MDLabel:
                        text: "POST /agent-api/v1/payments/checkout · X-CyberCash-API-Key + Idempotency-Key"
                        theme_text_color: "Secondary"
                        font_size: sp(11)
                        adaptive_height: True

                    MDTextField:
                        id: api_key_name
                        hint_text: "Key name (for example, My Store)"
                        text: "My Store"
                        max_text_length: 60
                        mode: "rectangle"
                        text_color_normal: 0.95, 0.95, 0.95, 1
                        text_color_focus: 1, 0.76, 0.12, 1
                        hint_text_color_normal: 0.62, 0.65, 0.69, 1
                        hint_text_color_focus: 1, 0.76, 0.12, 1
                        line_color_normal: 0.36, 0.39, 0.43, 1
                        line_color_focus: 1, 0.76, 0.12, 1
                        size_hint_y: None
                        height: dp(52)

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(8)

                        MDRaisedButton:
                            id: test_mode_button
                            text: "Test mode"
                            on_release: root.select_api_mode("test")

                        MDRaisedButton:
                            id: live_mode_button
                            text: "Live mode"
                            on_release: root.select_api_mode("live")

                    MDLabel:
                        id: api_key_status
                        text: "Loading API keys…"
                        theme_text_color: "Secondary"
                        font_size: sp(12)
                        adaptive_height: True

                    MDTextField:
                        id: api_key_secret
                        hint_text: "New key appears once"
                        readonly: True
                        multiline: False
                        mode: "rectangle"
                        text_color_normal: 0.95, 0.95, 0.95, 1
                        text_color_focus: 1, 0.76, 0.12, 1
                        hint_text_color_normal: 0.62, 0.65, 0.69, 1
                        hint_text_color_focus: 1, 0.76, 0.12, 1
                        line_color_normal: 0.36, 0.39, 0.43, 1
                        line_color_focus: 1, 0.76, 0.12, 1
                        size_hint_y: None
                        height: dp(52)

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(44)
                        spacing: dp(8)

                        MDRaisedButton:
                            id: copy_api_key_button
                            text: "Copy key"
                            disabled: True
                            on_release: root.copy_api_key()

                        MDRaisedButton:
                            id: generate_api_key_button
                            text: "Generate key"
                            on_release: root.generate_api_key()

                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height + dp(28)
                    radius: [dp(20)]
                    elevation: 0
                    md_bg_color: 0.09, 0.10, 0.12, 1
                    padding: dp(16)
                    spacing: dp(8)

                    MDLabel:
                        text: "Your API keys"
                        bold: True
                        font_size: sp(16)
                        adaptive_height: True

                    MDBoxLayout:
                        id: api_keys_list
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(5)

        BottomNavBar:
            nav_variant: "agent"
            active_target: "agent"
            bar_color: app.ui_surface
            active_color: app.gold
            inactive_color: app.ui_text_secondary
