#:import TransactionCard features.transactions.transaction_card.TransactionCard

<AgentDashboard>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.03, 0.03, 0.03, 1

        MDBoxLayout:
            size_hint_y: None
            height: "72dp"
            padding: "18dp", "12dp"

            MDLabel:
                text: "Agent Dashboard"
                bold: True
                font_size: "22sp"
                theme_text_color: "Custom"
                text_color: 1, 0.76, 0.12, 1

            Widget:

            MDRaisedButton:
                text: "KYC"
                md_bg_color: 0.16, 0.16, 0.16, 1
                on_release: root.apply_for_agent()

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: "16dp"
                padding: "16dp"

                MDCard:
                    size_hint_y: None
                    height: "190dp"
                    radius: [24, 24, 24, 24]
                    elevation: 8
                    md_bg_color: 0.08, 0.08, 0.08, 1
                    padding: "16dp"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "6dp"

                        MDLabel:
                            text: "Agent Status"
                            theme_text_color: "Secondary"

                        MDLabel:
                            id: agent_status
                            text: "Pending"
                            font_size: "30sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 0.76, 0.12, 1

                        MDLabel:
                            id: agent_verified
                            text: "Pending Review"
                            theme_text_color: "Secondary"

                        MDBoxLayout:
                            adaptive_height: True
                            spacing: "10dp"

                            MDLabel:
                                text: "Commission Balance"
                                theme_text_color: "Secondary"

                            MDLabel:
                                id: commission_balance
                                text: "GH₵ 0.00"
                                bold: True
                                halign: "right"

                        MDBoxLayout:
                            adaptive_height: True
                            spacing: "10dp"

                            MDLabel:
                                text: "Today's Sales"
                                theme_text_color: "Secondary"

                            MDLabel:
                                id: today_sales
                                text: "GH₵ 0.00"
                                bold: True
                                halign: "right"

                        MDBoxLayout:
                            adaptive_height: True
                            spacing: "10dp"

                            MDLabel:
                                text: "Customers Served"
                                theme_text_color: "Secondary"

                            MDLabel:
                                id: customers_served
                                text: "0"
                                bold: True
                                halign: "right"

                MDCard:
                    size_hint_y: None
                    height: "170dp"
                    radius: [24, 24, 24, 24]
                    elevation: 6
                    md_bg_color: 0.09, 0.09, 0.09, 1
                    padding: "16dp"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "10dp"

                        MDLabel:
                            text: "Commission Summary"
                            bold: True
                            font_size: "18sp"

                        MDBoxLayout:
                            adaptive_height: True
                            spacing: "10dp"

                            MDLabel:
                                text: "Today"
                                theme_text_color: "Secondary"

                            MDLabel:
                                id: commission_today
                                text: "GH₵ 0.00"
                                bold: True
                                halign: "right"

                        MDBoxLayout:
                            adaptive_height: True
                            spacing: "10dp"

                            MDLabel:
                                text: "This Week"
                                theme_text_color: "Secondary"

                            MDLabel:
                                id: commission_week
                                text: "GH₵ 0.00"
                                bold: True
                                halign: "right"

                        MDBoxLayout:
                            adaptive_height: True
                            spacing: "10dp"

                            MDLabel:
                                text: "Total Earned"
                                theme_text_color: "Secondary"

                            MDLabel:
                                id: commission_total
                                text: "GH₵ 0.00"
                                bold: True
                                halign: "right"

                MDGridLayout:
                    cols: 3
                    adaptive_height: True
                    spacing: "10dp"

                    MDRaisedButton:
                        text: "Sell Airtime"
                        md_bg_color: 0.16, 0.16, 0.16, 1
                        on_release: root.sell_airtime()

                    MDRaisedButton:
                        text: "Sell Data"
                        md_bg_color: 0.16, 0.16, 0.16, 1
                        on_release: root.sell_data()

                    MDRaisedButton:
                        text: "View Commission"
                        md_bg_color: 1, 0.76, 0.12, 1
                        text_color: 0, 0, 0, 1
                        on_release: root.view_commission()

                MDCard:
                    size_hint_y: None
                    height: "320dp"
                    radius: [24, 24, 24, 24]
                    elevation: 6
                    md_bg_color: 0.09, 0.09, 0.09, 1
                    padding: "16dp"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "10dp"

                        MDLabel:
                            text: "Recent Agent Transactions"
                            bold: True
                            font_size: "18sp"

                        RecycleView:
                            id: transaction_list
                            viewclass: "TransactionCard"
                            size_hint_y: None
                            height: "250dp"

                            RecycleGridLayout:
                                cols: 1
                                default_size: None, "88dp"
                                default_size_hint: 1, None
                                size_hint_y: None
                                height: self.minimum_height
                                spacing: "10dp"

