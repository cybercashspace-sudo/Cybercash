#:import dp kivy.metrics.dp
#:import theme theme
#:import GlassCard widgets.GlassCard
#:import EmptyState components.empty_state.EmptyState
#:import AppButton components.app_button.AppButton
#:import AppTextField components.app_textfield.AppTextField
#:import RefreshIndicator components.refresh_indicator.RefreshIndicator
#:import TransactionCard features.transactions.transaction_card.TransactionCard

<TransactionCard>:
    size_hint_y: None
    height: dp(92)
    radius: [dp(18)]
    padding: [dp(12), dp(10), dp(12), dp(10)]
    elevation: 0
    md_bg_color: (0.11, 0.11, 0.12, 1) if root.is_read else (0.13, 0.13, 0.15, 1)
    line_color: root.accent_color

    MDBoxLayout:
        orientation: "horizontal"
        spacing: dp(10)

        MDCard:
            size_hint: None, None
            size: dp(42), dp(42)
            radius: [dp(12)]
            md_bg_color: root.accent_color
            elevation: 0

            MDIcon:
                icon: root.icon
                theme_text_color: "Custom"
                text_color: 0.05, 0.05, 0.05, 1
                pos_hint: {"center_x": .5, "center_y": .5}

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(2)

            MDLabel:
                text: root.title
                bold: True
                theme_text_color: "Custom"
                text_color: theme.TEXT_PRIMARY
                shorten: True
                shorten_from: "right"

            MDLabel:
                text: root.description
                theme_text_color: "Hint"
                font_size: "12sp"
                shorten: True
                shorten_from: "right"

            MDLabel:
                text: root.date_text
                theme_text_color: "Hint"
                font_size: "11sp"

        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: dp(120)
            spacing: dp(2)

            MDLabel:
                text: root.amount_text
                halign: "right"
                bold: True
                theme_text_color: "Custom"
                text_color: root.accent_color

            MDLabel:
                text: root.status_text
                halign: "right"
                theme_text_color: "Custom"
                text_color: root.status_color
                font_size: "11sp"

<TransactionScreen>:
    MDFloatLayout:
        canvas.before:
            Color:
                rgba: theme.BACKGROUND
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: 0
            on_scroll_y: root.on_scroll_y(self, self.scroll_y)

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20), dp(24), dp(20), dp(28)
                spacing: dp(16)

                MDBoxLayout:
                    id: title_block
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(6)

                    MDLabel:
                        text: "Transaction History"
                        font_size: "28sp"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_PRIMARY

                    MDLabel:
                        text: "Recent wallet activity"
                        theme_text_color: "Hint"

                GlassCard:
                    id: filter_card
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [28]
                    padding: dp(14)
                    spacing: dp(12)
                    elevation: 0
                    md_bg_color: theme.GLASS_BG
                    line_color: theme.GLASS_BORDER

                    AppTextField:
                        id: search
                        hint_text: "Search transactions"
                        helper_text: "Type a reference, amount, or description"
                        helper_text_mode: "on_focus"
                        icon_left: "magnify"
                        on_text: root.search_query = self.text

                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(10)

                        Widget:

                    AppButton:
                        id: refresh_button
                        text: "Refresh"
                        variant: "secondary"
                        size_hint_x: None
                        width: dp(140)
                        height: dp(46)
                        on_release: root.refresh_transactions()

                    RefreshIndicator:
                        active: root.loading
                        text: "Refreshing transactions..."
                        show_text: True
                        size_hint_y: None
                        height: dp(24) if root.loading else 0
                        opacity: 1 if root.loading else 0
                        disabled: not root.loading

                    MDSegmentedButton:
                        size_hint_y: None
                        height: dp(48)

                        MDSegmentedButtonItem:
                            text: "All"
                            active: True
                            on_release: root.set_filter("all")

                        MDSegmentedButtonItem:
                            text: "Deposits"
                            on_release: root.set_filter("deposit")

                        MDSegmentedButtonItem:
                            text: "Transfers"
                            on_release: root.set_filter("transfer")

                        MDSegmentedButtonItem:
                            text: "Withdrawals"
                            on_release: root.set_filter("withdraw")

                GlassCard:
                    id: list_card
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(520)
                    radius: [28]
                    padding: dp(10)
                    elevation: 0
                    md_bg_color: theme.GLASS_BG
                    line_color: theme.GLASS_BORDER

                    EmptyState:
                        icon: root.empty_state_icon
                        title: root.empty_state_title
                        message: root.empty_state_message
                        size_hint_y: None
                        height: self.minimum_height if root.show_empty_state else 0
                        opacity: 1 if root.show_empty_state else 0
                        disabled: not root.show_empty_state

                    RecycleView:
                        id: transaction_list
                        viewclass: "TransactionCard"
                        scroll_type: ["bars", "content"]
                        bar_width: dp(4)
                        opacity: 1 if root.has_transactions else 0
                        disabled: not root.has_transactions
                        size_hint_y: None
                        height: dp(430) if root.has_transactions else 0

                        RecycleBoxLayout:
                            default_size: None, dp(92)
                            default_size_hint: 1, None
                            size_hint_y: None
                            height: self.minimum_height
                            orientation: "vertical"
                            spacing: dp(10)
