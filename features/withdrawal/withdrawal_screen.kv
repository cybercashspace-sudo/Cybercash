#:import dp kivy.metrics.dp
#:import theme theme
#:import GlassCard widgets.GlassCard
#:import AuthButton features.auth.widgets.auth_button.AuthButton

<WithdrawalScreen>:
    MDFloatLayout:
        canvas.before:
            Color:
                rgba: theme.BACKGROUND
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20), dp(24), dp(20), dp(28)
                spacing: dp(16)

                MDBoxLayout:
                    id: title_block
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(6)

                    MDLabel:
                        text: "Withdraw Funds"
                        font_size: "28sp"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_PRIMARY

                    MDLabel:
                        text: "Send money to mobile money safely"
                        theme_text_color: "Hint"

                GlassCard:
                    id: amount_card
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(18)
                    spacing: dp(14)

                    MDLabel:
                        text: "Amount"
                        theme_text_color: "Hint"

                    MDTextField:
                        id: amount
                        hint_text: "GHS 0.00"
                        mode: "outlined"
                        input_filter: "float"
                        helper_text: "Enter the withdrawal amount"
                        helper_text_mode: "on_focus"

                GlassCard:
                    id: network_card
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(18)
                    spacing: dp(14)

                    MDLabel:
                        text: "Mobile Network"
                        theme_text_color: "Hint"

                    MDSegmentedButton:
                        id: network_picker
                        size_hint_y: None
                        height: dp(48)

                        MDSegmentedButtonItem:
                            text: "Auto"
                            active: True
                            on_release: root.set_network("auto")

                        MDSegmentedButtonItem:
                            text: "MTN"
                            on_release: root.set_network("mtn")

                        MDSegmentedButtonItem:
                            text: "Telecel"
                            on_release: root.set_network("telecel")

                        MDSegmentedButtonItem:
                            text: "AirtelTigo"
                            on_release: root.set_network("airteltigo")

                    MDLabel:
                        text: "Detected: " + root.detected_network
                        theme_text_color: "Hint"
                        font_size: "12sp"

                GlassCard:
                    id: details_card
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(18)
                    spacing: dp(14)

                    MDTextField:
                        id: phone
                        hint_text: "MoMo Number"
                        mode: "outlined"
                        input_filter: "int"
                        helper_text: "Enter the mobile money number"
                        helper_text_mode: "on_focus"
                        on_text: root.update_detected_network()

                    MDTextField:
                        id: pin
                        hint_text: "Confirm PIN"
                        mode: "outlined"
                        password: True
                        input_filter: "int"
                        helper_text: "Enter your 4-digit PIN"
                        helper_text_mode: "on_focus"

                AuthButton:
                    id: withdraw_button
                    text: "WITHDRAW"
                    busy_text: "PROCESSING..."
                    on_release: root.submit_withdrawal()
