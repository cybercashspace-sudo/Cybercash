# CYBER CASH environment template
# Copy values into .env and add real secrets locally.

# Runtime
ENV=development
PORT=8000
RUNNING_TESTS=false
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
STARTUP_DB_INIT_TIMEOUT_SECONDS=25

# Database
DATABASE_URL=sqlite+aiosqlite:///./cybercash.db
SYNC_DATABASE_URL=sqlite:///./cybercash.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/cybercash
# SYNC_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/cybercash

# Kivy / client API target
KIVY_API_URL=
CYBERCASH_API_URL=
BACKEND_URL=

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_FROM_NAME=CyberCash

# OTP / SMS
OTP_PROVIDER=log
SMS_PROVIDER=log
SMS_SENDER_ID=CyberCash
ALLOW_EXTERNAL_SMS_IN_DEV=false
EXPOSE_OTP_IN_API=false
OTP_TTL_SECONDS=120
SMS_RATE_LIMIT_PER_HOUR=5
SMS_RATE_LIMIT_WINDOW_SECONDS=3600

# MNotify SMS
MNOTIFY_API_KEY=
MNOTIFY_SENDER=CyberCash
MNOTIFY_SMS_URL=https://api.mnotify.com/api/sms/quick

# Hubtel SMS / OTP
HUBTEL_AUTH=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_BASE_URL=https://api-otp.hubtel.com
HUBTEL_SMS_URL=https://sms.hubtel.com/v1/messages/send
HUBTEL_SENDER_ID=CyberCash
HUBTEL_COUNTRY_CODE=GH
HUBTEL_TIMEOUT_SECONDS=10

# Arkesel SMS
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=CyberCash
ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Redis / OTP storage
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_SECRET=
PAYSTACK_API_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WALLET_CALLBACK_URL=
PAYSTACK_MIN_WALLET_TOPUP_GHS=1.0
PAYSTACK_MAX_WALLET_TOPUP_GHS=10000.0
PAYSTACK_FALLBACK_EMAIL_DOMAIN=cybercash.app

# Flutterwave
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_TOKEN_URL=https://idp.flutterwave.com/oauth/token
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Binance
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TIMEOUT_SECONDS=10
BINANCE_RECV_WINDOW=5000
BINANCE_WITHDRAWALS_ENABLED=false

# iData bundles
IDATA_API_KEY=
IDATA_BASE_URL=https://idatagh.com/wp-json/custom/v1
IDATA_TIMEOUT_SECONDS=12
IDATA_USER_MARKUP_PERCENTAGE=0.10
IDATA_USER_MARKUP_GHS=0.0
IDATA_SEND_SMS=false

# Airtime cash
AIRTIME_CASH_PAYOUT_RATE=0.80
AIRTIME_CASH_MIN_AMOUNT=1.0
AIRTIME_CASH_MAX_AMOUNT=1000.0
AIRTIME_CASH_MANUAL_REVIEW_THRESHOLD=200.0
AIRTIME_CASH_MERCHANT_MTN=0559000000
AIRTIME_CASH_MERCHANT_TELECEL=0209000000
AIRTIME_CASH_MERCHANT_AIRTELTIGO=0279000000
AIRTIME_CASH_MERCHANT_DEFAULT=0559000000
AIRTIME_CASH_SMS_WEBHOOK_TOKEN=
AIRTIME_CASH_MOMO_CALLBACK_URL=

# Agent / wallet / fees
AGENT_REGISTRATION_FEE=100.0
AGENT_STARTUP_LOAN_AMOUNT=50.0
TRANSACTION_FEE_PERCENTAGE=0.01
AGENT_COMMISSION_RATE=0.02
AGENT_DATA_BUNDLE_DISCOUNT_GHS=0.50
WITHDRAWAL_APPROVAL_THRESHOLD_GHS=1000.0
FX_SPREAD_PERCENTAGE=0.01

# Escrow
ESCROW_MIN_DEAL_AMOUNT_GHS=20.0
ESCROW_CREATE_FEE_GHS=5.0
ESCROW_RELEASE_FEE_GHS=5.0

# Investment
INVESTMENT_MIN_AMOUNT_GHS=10.0
INVESTMENT_MIN_DAYS=7
INVESTMENT_MAX_DAYS=365
INVESTMENT_RISK_FREE_ANNUAL_RATE=12.0
INVESTMENT_PROFIT_FEE_RATE=0.10

# Virtual cards
VIRTUAL_CARD_CREATION_FEE_GHS=25.0
VIRTUAL_CARD_ISSUANCE_FEE_RECHARGEABLE=25.0
VIRTUAL_CARD_ISSUANCE_FEE_ONETIME=25.0
CARD_PROCESSOR_WEBHOOK_KEY=change-me-card-processor-webhook-key

# USSD / crypto / loans
USSD_SHORTCODE="*360#"
BTC_DEPOSIT_REQUIRED_CONFIRMATIONS=3
BTC_MARKET_URL=https://api.binance.com/api/v3/ticker/24hr?symbol=BTCUSDT
LOAN_REPAYMENT_PERCENTAGE=0.20
MAX_FLOAT_WITHDRAWAL_PERCENTAGE=0.50
MAX_LOAN_AMOUNT_PER_AGENT=5000.0
DEFAULT_PENALTY_FEE_PERCENTAGE=0.05
RISK_SCORE_APPROVAL_THRESHOLD=50
